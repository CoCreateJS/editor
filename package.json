{
  "name": "@cocreate/editor",
  "version": "1.0.0",
  "description": "Extensible collaborative editor for text, HTML/DOM, Markdown, and code with syntax highlighting and optional CRDT sync.",
  "keywords": [
    "cocreate",
    "editor",
    "text",
    "code",
    "editor-framework",
    "extensible",
    "parser",
    "rendering",
    "crdt",
    "syntax-highlighting",
    "html",
    "markdown"
  ],
  "browser": "./src/index.js",
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch",
    "test": "node --test test/*.cjs"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "homepage": "https://CoCreateJS.com/docs/editor",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreateJS"
  },
  "type": "module",
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/element-prototype": "^2.0.0",
    "@cocreate/observer": "^2.0.0",
    "@cocreate/crdt": "^2.0.0",
    "@cocreate/utils": "^2.0.0"
  },
  "devDependencies": {
    "@cocreate/webpack": "^2.0.0",
    "playwright-core": "^1.64.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/editor.git"
  },
  "bugs": {
    "url": "https://github.com/CoCreateJS/editor/issues"
  }
